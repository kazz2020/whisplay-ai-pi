# Raspberry Pi 5 8GB fully local Whisplay preset
# Local ASR + local llama.cpp LLM + local Piper HTTP TTS

ASR_SERVER=faster-whisper
LLM_SERVER=llama.cpp
TTS_SERVER=piper-http

IMAGE_GENERATION_SERVER=
ENABLE_THINKING=false
USE_CAPTURED_IMAGE_IN_CHAT=false
MALLOC_ARENA_MAX=2
MALLOC_TRIM_THRESHOLD_=131072

LLAMA_CPP_ENDPOINT=http://127.0.0.1:8080
LLAMA_CPP_MODEL=qwen2.5-1.5b-instruct
LLAMA_CPP_ALIAS=qwen2.5-1.5b-instruct
LLAMA_CPP_HF_REPO=bartowski/Qwen2.5-1.5B-Instruct-GGUF:Q4_K_M
# Optional if Hugging Face model access requires authentication:
# LLAMA_CPP_HF_TOKEN=hf_xxx
LLAMA_CPP_HOST=127.0.0.1
LLAMA_CPP_PORT=8080
LLAMA_CPP_THREADS=4
LLAMA_CPP_CONTEXT_SIZE=2048
LLAMA_CPP_BATCH_SIZE=256
LLAMA_CPP_UBATCH_SIZE=128
LLAMA_CPP_N_GPU_LAYERS=0
LLAMA_CPP_FLASH_ATTN=off
LLAMA_CPP_JINJA=true
LLAMA_CPP_REASONING=off
LLAMA_CPP_ENABLE_TOOLS=false
LLAMA_CPP_USE_STREAM=true
LLAMA_CPP_MAX_MESSAGES_LENGTH=12
LLAMA_CPP_EXTRA_ARGS="--parallel 1"
SERVE_LLAMA_CPP=true

SYSTEM_PROMPT="You are a local voice assistant running on a Raspberry Pi. Give direct, useful answers in English. Keep replies short, concrete, and accurate. If you are unsure, say so plainly instead of guessing."

FASTER_WHISPER_HOST=localhost
FASTER_WHISPER_PORT=8803
FASTER_WHISPER_MODEL_SIZE_OR_PATH=tiny
FASTER_WHISPER_LANGUAGE=en
FASTER_WHISPER_REQUEST_TYPE=filePath

PIPER_HTTP_HOST=localhost
PIPER_HTTP_PORT=8805
PIPER_HTTP_MODEL=/home/pi/piper/en_US-lessac-medium
PIPER_HTTP_LENGTH_SCALE=1

# To compare Sherpa ONNX later, switch TTS_SERVER=sherpa-onnx and set:
# SHERPA_ONNX_TTS_HOST=127.0.0.1
# SHERPA_ONNX_TTS_PORT=8809
# SHERPA_ONNX_TTS_MODEL_DIR=/home/pi/sherpa-onnx-tts/vits-piper-pl_PL-gosia-medium
# SHERPA_ONNX_TTS_NUM_THREADS=2
# SHERPA_ONNX_TTS_PROVIDER=cpu
# SHERPA_ONNX_TTS_SPEAKER_ID=0
# SHERPA_ONNX_TTS_SPEED=1.0

# Optional RAG setup for local knowledge retrieval
# Put .txt or .md files into the repository knowledge/ directory, then run: bash index_knowledge.sh
# ENABLE_RAG=true
# EMBEDDING_SERVER=ollama
# VECTOR_DB_SERVER=qdrant
# SERVE_QDRANT=true
# QDRANT_HOST=http://127.0.0.1:6333
# Use native Ollama on the Pi: http://127.0.0.1:11434
# Or use another Ollama machine on your LAN, for example:
# OLLAMA_EMBEDDING_ENDPOINT=http://192.168.1.100:11434
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# RAG_KNOWLEDGE_SCORE_THRESHOLD=0.60
# For Polish voice queries, a lower threshold and slightly broader retrieval often works better:
# RAG_KNOWLEDGE_SCORE_THRESHOLD=0.55
# RAG_KNOWLEDGE_TOP_K=6
# RAG_KNOWLEDGE_MAX_CHUNKS=4
# RAG_KNOWLEDGE_MAX_CHUNKS_PER_SOURCE=2
# RAG_KNOWLEDGE_MAX_CONTEXT_CHARS=2200

# Optional wake word with local-wake (record samples with scripts/setup_local_wakeword.sh)
# WAKE_WORD_ENABLED=true
# WAKE_WORD_ENGINE=local-wake
# WAKE_WORD_PHRASE=hey whisplay
# WAKE_WORD_REFERENCE_DIR=/home/pi/whisplay-ai-chatbot/data/wakewords/hey-whisplay
# WAKE_WORD_THRESHOLD=0.10
# WAKE_WORD_LOCAL_WAKE_TRIGGER_DISTANCE=0.09
# WAKE_WORD_LOCAL_WAKE_BUFFER_SIZE=1.8
# WAKE_WORD_LOCAL_WAKE_SLIDE_SIZE=0.25
# WAKE_WORD_COOLDOWN_SEC=2.5
# WAKE_WORD_END_KEYWORDS=byebye,goodbye,stop
